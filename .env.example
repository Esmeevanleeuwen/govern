# scripts/start.sh or scripts/start.cmd creates .env with random passwords.
APP_PORT=8080
DB_NAME=bestuursatlas
# Extra workspaces, explicitly enabled on startup; existing data is preserved.
# Example: DB_DATABASES=onderzoek,project_data
DB_DATABASES=
DB_PASSWORD=
DB_READ_PASSWORD=
DB_ROOT_PASSWORD=
# Local AI is optional and disabled until Ollama is installed and reachable.
AI_ENABLED=0
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen3:4b-instruct
AI_TIMEOUT_SECONDS=60
