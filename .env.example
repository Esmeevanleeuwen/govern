# scripts/start.sh or scripts/start.cmd creates .env with random passwords.
APP_PORT=8080
# Add an exact LAN host only when using the explicit HTTPS override.
APP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
DB_NAME=bestuursatlas
# Extra workspaces, explicitly enabled on startup; existing data is preserved.
# Example: DB_DATABASES=onderzoek,project_data
DB_DATABASES=
DB_PASSWORD=
DB_READ_PASSWORD=
DB_ROOT_PASSWORD=
# Local AI is optional and disabled until Ollama is installed and reachable.
AI_ENABLED=0
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=qwen3:4b-instruct
AI_TIMEOUT_SECONDS=60

# Optional PostgreSQL workspace alongside MariaDB. Set to 1, then run start again.
# The scripts generate missing PostgreSQL passwords without changing existing ones.
PG_ENABLED=0
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=govern_pg
PG_SCHEMAS=public
PG_READ_USER=govern_pg_reader
PG_READ_PASSWORD=
# Scoped row writer; independent from the read-only account.
PG_USER=govern_pg_writer
PG_PASSWORD=
# Free SQL has its own schema-scoped account, separate from row editing.
PG_SQL_USER=govern_pg_sql
PG_SQL_PASSWORD=
# Restricted restore login; its password is only passed to private services.
PG_RESTORE_USER=govern_pg_restore
PG_RESTORE_PASSWORD=
# Bootstrap only: this password is never passed to the web application.
PG_ADMIN_PASSWORD=

# Separate whiteboard webapp, backed by the existing PostgreSQL connection.
# Enable PG first, add brainstorm to PG_SCHEMAS, then run provision-studio.sh.
STUDIO_ENABLED=0
STUDIO_SCHEMA=brainstorm
STUDIO_TRANSCRIPTION_ENABLED=0
# Whisper-compatible HTTP service; no model or cloud service is enabled implicitly.
STUDIO_TRANSCRIPTION_URL=http://transcriber:8080/v1/audio/transcriptions
STUDIO_TRANSCRIPTION_MODEL=whisper-1
STUDIO_TRANSCRIPTION_TIMEOUT_SECONDS=30
STUDIO_TRANSCRIPTION_ALLOW_REMOTE=0
STUDIO_TRANSCRIPTION_API_KEY=
# Optional LAN HTTPS override; default still binds to this computer only.
STUDIO_LAN_BIND=127.0.0.1
STUDIO_LAN_HOST=localhost
STUDIO_HTTPS_PORT=8443

# Read-only transcript feed for the separate GhostSketch backend. Empty = disabled.
GHOSTSKETCH_READ_TOKEN=
