{
    admin off
    auto_https disable_redirects
}

https://:443 {
    tls /run/studio-tls/cert.pem /run/studio-tls/key.pem
    @wrong_host not host {$STUDIO_LAN_HOST}
    respond @wrong_host 421
    # Native database administration stays on the existing local gateway.
    @database_admin path /phpmyadmin /phpmyadmin/*
    respond @database_admin 404
    reverse_proxy app:80 {
        header_up X-Forwarded-Proto https
        header_up -X-Forwarded-Host
    }
}
